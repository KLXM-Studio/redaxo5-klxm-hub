klxm_hub_col_actions = Aktionen
klxm_hub_state_active = aktiv
klxm_hub_state_locked = gesperrt
klxm_hub_state_local_password = hat ein lokales Passwort – Anmeldung über den Hub abgelehnt
klxm_hub_lock = Sperren
klxm_hub_unlock = Entsperren
klxm_hub_lock_confirm = Agentur-Konto sperren? Laufende Sitzungen enden sofort.
klxm_hub_locked = Konto gesperrt.
klxm_hub_unlocked = Konto entsperrt.

