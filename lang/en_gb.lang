klxm_hub_err_mfa = This sign-in requires a second factor.
klxm_hub_err_role = There is no grant with a matching role for this website.
klxm_hub_err_locked = This account is locked.
klxm_hub_err_local_password = This account has a local password and cannot sign in via the hub.
klxm_hub_err_no_account = There is no access for this account here.
klxm_hub_err_login_taken = A user with this login already exists here – it is not taken over.
klxm_hub_err_rate_limit = Too many attempts. Please try again in a few minutes.
klxm_hub_err_account = This account cannot be changed here.
klxm_hub_err_passkey = Agency accounts sign in via the hub only.

