klxm_hub_login_button = Sign in with {0}
klxm_hub_login_note = For agency staff, with a second factor.

klxm_hub_section_oidc = Sign-in via the hub (OpenID Connect)
klxm_hub_oidc_enabled = Sign-in
klxm_hub_oidc_enabled_label = Offer sign-in via the provider
klxm_hub_oidc_enabled_note = Shows a button on the backend login page. Signing in with user name and password stays available – keep local admins (emergency access).
klxm_hub_oidc_name = Provider name
klxm_hub_oidc_name_note = Label of the button and marker of the accounts.
klxm_hub_oidc_issuer = Issuer
klxm_hub_oidc_issuer_note = Address of the hub, e.g. https://hub.klxm.de/hub – exactly as the hub states it. The addon reads the settings from {Issuer}/.well-known/openid-configuration.
klxm_hub_oidc_client_id = Client ID
klxm_hub_oidc_client_secret = Client secret
klxm_hub_secret_saved = Saved (encrypted). Leave empty to keep it.
klxm_hub_secret_missing = Not entered yet. The hub shows it once when the instance is registered.
klxm_hub_secret_env = Taken from the environment variable KLXM_HUB_CLIENT_SECRET.
klxm_hub_secret_forget = Remove secret
klxm_hub_secret_forget_confirm = Remove the client secret? Signing in via the hub will stop working.
klxm_hub_secret_forgotten = Client secret removed.
klxm_hub_oidc_auth = Authentication at the token endpoint
klxm_hub_oidc_roles = Roles from the hub
klxm_hub_oidc_roles_note = For each grant the hub sends the role admin or redaktion (claim “roles”). Without a matching role there is no sign-in. Permissions are synchronised on every sign-in.
klxm_hub_role_admin = Admin
klxm_hub_role_none = – none (redaktion is refused) –
klxm_hub_role_redaktion_short = Editor
klxm_hub_oidc_jit = Accounts
klxm_hub_oidc_jit_label = Create the account on first sign-in
klxm_hub_oidc_jit_note = Creates marked agency accounts without a local password. Existing users are never taken over.

klxm_hub_section_addresses = Addresses for the hub
klxm_hub_addresses_note = Enter these addresses when registering the instance in the hub (under “Addresses”, exactly like this).
klxm_hub_addresses_instance_note = “Detect addresses” in the hub reads /.well-known/klxm-studio (reachable with yrewrite or a rewrite rule to index.php) – without a rewrite rule the “Self-description” address returns the same content.
klxm_hub_addr_redirect = Redirect URI
klxm_hub_addr_start = Initiate login
klxm_hub_addr_status = Status address
klxm_hub_addr_logout = After sign-out
klxm_hub_addr_instance = Self-description
klxm_hub_warn_no_base_url = The website URL (System → Settings) is not set or still holds the default – the addresses depend on the host of each request. Please enter the website URL so the redirect URI is always fixed.

klxm_hub_section_monitor = Monitoring (signed status request)
klxm_hub_monitor_enabled = Status request
klxm_hub_monitor_enabled_label = Allow signed status requests
klxm_hub_monitor_enabled_note = The hub reads versions, addons, checks and the latest backup – only with a valid signature, no content and no personal data. When switched off the address answers “not found”.
klxm_hub_monitor_keys = Keys of the hub
klxm_hub_monitor_keys_note = One public key “ed25519:…” per line, optionally preceded by a label (at most 10). Found in the hub under Settings → Agentur Hub.
klxm_hub_monitor_backup = Backup folder
klxm_hub_monitor_backup_note = Optional: absolute or relative to the project folder. Only the time of the newest file (*.sql, *.sql.gz, *.tar.gz, *.tgz, *.zip) is reported, never the path.
klxm_hub_monitor_key_invalid = Invalid key: “{0}” – expected “ed25519:…” (optionally preceded by a label).
klxm_hub_monitor_key_too_many = At most {0} keys.
klxm_hub_monitor_key_required = At least one key of the hub is required to switch it on.
klxm_hub_saved_monitor = Monitoring saved.

klxm_hub_section_preview = Preview of the response
klxm_hub_preview_note = This is what the hub sees of this instance (without cache).

klxm_hub_saved_oidc = Sign-in via the hub saved (switched off).
klxm_hub_saved_oidc_ok = Sign-in via the hub saved – the provider is reachable.
klxm_hub_err_incomplete = Issuer, client ID or client secret are missing – sign-in stays off.
klxm_hub_err_issuer_format = The issuer must be an address starting with http(s)://.
klxm_hub_err_discovery_save = The provider is not reachable or its metadata does not match ({0}) – sign-in stays off.
klxm_hub_warn_no_local_admin = There is no active admin with a password. Please keep a local emergency admin so the backend stays reachable without the hub.

klxm_hub_err_generic = Signing in via the hub did not work. Please try again.
klxm_hub_err_state = The sign-in has expired or is invalid. Please start again.
klxm_hub_err_provider_cancelled = The sign-in was cancelled at the provider.
klxm_hub_err_provider_unreachable = The provider is not reachable right now.
klxm_hub_err_discovery = The provider's metadata does not match the settings.
klxm_hub_err_issuer_insecure = The provider must be reachable via https.
